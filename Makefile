# picklescope developer tasks. `make check` is the single quality gate (CI runs it too).
UV ?= uv
RUN := $(UV) run
SRC := src tests scripts

.PHONY: install format format-check lint typecheck test cov check demo fixtures docs \
        fetch-models eval bench clean

install:
	$(UV) sync --frozen

format:
	$(RUN) ruff format $(SRC)
	$(RUN) ruff check --fix $(SRC)

format-check:
	$(RUN) ruff format --check $(SRC)

lint:
	$(RUN) ruff check $(SRC)

typecheck:
	$(RUN) mypy

test:
	$(RUN) pytest

cov:
	$(RUN) pytest --cov --cov-report=term-missing

# format-check + lint (zero warnings) + mypy --strict + tests with the coverage gate
check: install format-check lint typecheck cov

demo:
	$(RUN) python -u scripts/demo.py

fixtures:
	$(RUN) python tests/fixturegen.py

docs:
	{ printf '# Rule catalogue\n\nGenerated by `make docs` (`picklescope rules -f markdown`); a test keeps it in sync.\n\n'; \
	  $(RUN) picklescope rules -f markdown; } > docs/RULES.md

fetch-models:
	$(RUN) python -u scripts/fetch_models.py

eval: fetch-models
	$(RUN) python -u scripts/eval_real_models.py
	$(RUN) python -u scripts/eval_fixtures.py

bench:
	$(RUN) python -u scripts/bench.py

clean:
	rm -rf .pytest_cache .mypy_cache .ruff_cache .coverage htmlcov dist build
